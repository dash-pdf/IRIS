# IRIS — Environment Variables
#
# Copy this file to .env and fill in your real keys.
# NEVER commit the .env file. It is in .gitignore.
#
# ── ElevenLabs (Voice Output & Speech Input) ───────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_AGENT_ID=your_agent_id_here
ELEVENLABS_VOICE_ID=ThT5KcBeYPX3keUQqHPh

# ── Cloud Intelligence Router ─────────────────────────────────
# Which intelligence provider to use:
# - router (default): Deterministic routing across free cloud models & tools
#   * Everyday conversation: OpenRouter free tier (openrouter/free)
#   * Complex reasoning: Gemini Flash free tier (gemini-3.8-flash)
#   * Exact calculations: Safe deterministic Python arithmetic & algebra
#   * Date & time: Deterministic system utilities
#   * Memory retrieval: Local conversation Markdown archives
# - openrouter: Direct OpenRouter free tier (openrouter/free)
# - google / gemini: Direct Gemini Developer API free tier (gemini-3.8-flash)
# - mock: Offline testing adapter
IRIS_LLM_PROVIDER=router

# Model selection (optional override; strict free-tier allowlist enforced):
# - OpenRouter: openrouter/free
# - Gemini: gemini-3.8-flash | gemini-2.5-flash | gemini-2.0-flash
# IRIS_LLM_MODEL=router/free

# ── Cloud Provider Credentials ────────────────────────────────
# OpenRouter API Key (required for everyday conversation routing)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini API Key (required for complex reasoning routing)
# Free-tier keys available via Google AI Studio Developer API.
GOOGLE_API_KEY=your_google_api_key_here

# Optional legacy/alternative provider keys
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# ── TTS & Audio Configuration ─────────────────────────────────
IRIS_TTS_PROVIDER=edge
IRIS_EDGE_VOICE=en-GB-SoniaNeural
IRIS_STT_PROVIDER=elevenlabs

# ── Conversation Archive & Memory ──────────────────────────────
# Where to write Markdown conversation logs (relative to project root).
IRIS_ARCHIVE_DIR=memory/conversations

# ── Context Engine (Location, Timezone & Weather) ──────────────
# Automatic device location tracking via macOS Location Services
IRIS_LOCATION_TRACKING=true

# Manual fallback location (used if macOS location permission is not granted or offline)
# IRIS_LOCATION_NAME=London, UK
# IRIS_LOCATION_LATITUDE=51.5074
# IRIS_LOCATION_LONGITUDE=-0.1278

# Weather provider: open-meteo (default, 100% free, requires no API key)
IRIS_WEATHER_PROVIDER=open-meteo
IRIS_WEATHER_API_KEY=

# Background context refresh interval in seconds (default 1800s = 30 minutes)
IRIS_CONTEXT_REFRESH_INTERVAL=1800

# Weather cache TTL in seconds (default 1800s = 30 minutes)
IRIS_WEATHER_CACHE_TTL=1800

# Directory for context cache (location_cache.json, weather_cache.json)
IRIS_CONTEXT_CACHE_DIR=memory/context

# ── IRIS Personality ──────────────────────────────────────────
IRIS_PERSONA_NAME=IRIS
