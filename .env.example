# IRIS — Environment Variables
#
# Copy this file to .env and fill in your real keys.
# NEVER commit the .env file. It is in .gitignore.
#
# ── ElevenLabs ────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ── LLM provider ──────────────────────────────────────────────
# Which provider to use: ollama | openrouter | google | anthropic | openai
IRIS_LLM_PROVIDER=openrouter

# Model selection:
# - For openrouter: defaults to openrouter/free
# - For ollama: defaults to llama3.2:1b
IRIS_LLM_MODEL=openrouter/free

# Local Ollama configuration (used when IRIS_LLM_PROVIDER=ollama)
# IRIS_OLLAMA_HOST=http://localhost:11434
# IRIS_OLLAMA_KEEP_ALIVE=30m
# Note: keep_alive keeps model weights resident in Apple Silicon unified memory (Metal cache)
# to eliminate cold-start load delays between turns (~1.5–2.5 GB memory footprint for 1B–3B models).

# Fill in only the key for the provider you are using.
OPENROUTER_API_KEY=your_openrouter_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ── ElevenLabs agent settings ─────────────────────────────────
# Set after creating your ConvAI agent in the ElevenLabs dashboard.
ELEVENLABS_AGENT_ID=your_agent_id_here

# ── Conversation archive ───────────────────────────────────────
# Where to write Markdown conversation logs (relative to project root).
IRIS_ARCHIVE_DIR=memory/conversations

# ── IRIS personality ──────────────────────────────────────────
IRIS_PERSONA_NAME=IRIS

